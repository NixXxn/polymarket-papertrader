# Coolify / Docker environment template
# Copy values into Coolify → Environment Variables (or use as .env for compose)

# --- Service mode ---
# both = trader loop + dashboard (default)
# dashboard = UI only
# trader = scan loop only (no web UI)
SERVICE=both
STRATEGY=both
PORT=8787

# Persistent ledger path inside the container (mount volume to /data)
PAPERTRADER_DATA_DIR=/data

# paper | live
PAPERTRADER_MODE=paper
PAPERTRADER_LIVE=0
PAPERTRADER_DRY_RUN=0
PAPERTRADER_RESET=0

# Dashboard HTTP basic auth (strongly recommended in production)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# Weather API (asymmetric strategy)
OPENWEATHER_API_KEY=

# Live trading (only if PAPERTRADER_MODE=live and PAPERTRADER_LIVE=1)
# PAPERTRADER_PRIVATE_KEY=0x...
# PAPERTRADER_FUNDER=0x...
# PAPERTRADER_SIGNATURE_TYPE=1

# Gunicorn tuning
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
